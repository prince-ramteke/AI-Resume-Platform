# Copy to .env and fill in. NEVER commit .env.

# Database
DB_URL=jdbc:postgresql://postgres:5432/resumeai
DB_USER=resumeai
DB_PASSWORD=change_me

# Auth
JWT_SECRET=replace_with_a_long_random_256bit_secret
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Rate limiting (POST /api/analyses only; in-memory Bucket4j, per user)
ANALYSIS_RATE_LIMIT_CAPACITY=5          # burst size (max requests with no wait)
ANALYSIS_RATE_LIMIT_REFILL_TOKENS=5     # tokens added per refill period
ANALYSIS_RATE_LIMIT_REFILL_PERIOD=15m   # e.g. 15m, 900s

# LLM
LLM_PROVIDER=ollama            # ollama | openai
LLM_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=                # optional; required only if using OpenAI/fallback
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0              # deterministic scoring
LLM_SEED=42                      # reproducible output (provider-dependent)
LLM_MAX_PROMPT_TOKENS=3500       # token budget for prompt assembly

# Admin bootstrap (required for first run)
ADMIN_EMAIL=admin@resumeai.local
ADMIN_PASSWORD=$2a$10$...        # pre-hashed BCrypt value

# RAG / chunking
RAG_CHUNK_SIZE=500                  # characters per chunk
RAG_CHUNK_OVERLAP=50                # characters shared between consecutive chunks (< chunk size)
RAG_RETRIEVAL_TOP_K=8               # max chunks returned per retrieval (hard-capped at 8)

# Hybrid retrieval (v1.1 — disabled by default; requires V6 full-text index migration)
RAG_HYBRID_ENABLED=false
RAG_HYBRID_RRF_K=60                # RRF damping constant (standard default 60)
RAG_HYBRID_CANDIDATE_POOL_SIZE=20  # candidates pulled per arm before fusion
RAG_HYBRID_KEYWORD_TERM_LIMIT=5    # max technical tokens extracted from query for plainto_tsquery (v1.2.M2)

# Embeddings
# --- Local / Ollama path (default) ---
EMBEDDING_PROVIDER=ollama           # ollama | openai
EMBEDDING_DIMENSIONS=768            # nomic-embed-text = 768; matches vector(768) column (V1 schema)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBED_MODEL=text-embedding-3-small
#
# --- Production / OpenAI path ---
# Switch ALL five values together. V7 migration widens the column to vector(1536).
# OPENAI_API_KEY=<required>
# EMBEDDING_PROVIDER=openai
# EMBEDDING_DIMENSIONS=1536         # text-embedding-3-small = 1536; matches vector(1536) column (V7 migration)
# LLM_PROVIDER=openai
# LLM_FALLBACK_ENABLED=false
#
# --- Production / Gemini path ($0 free tier, no credit card) ---
# Switch ALL values together. Requires V7 schema (vector(1536)). Gemini chat uses
# OpenAiLlmClient pointed at Gemini's OpenAI-compatible endpoint.
# GEMINI_API_KEY=<required — Google AI Studio key, no credit card needed>
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_DIMENSIONS=1536         # gemini-embedding-2 at 1536 dims; matches vector(1536) column (V7 migration)
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# LLM_PROVIDER=openai               # reuses OpenAiLlmClient via Gemini's OpenAI-compatible endpoint
# LLM_FALLBACK_ENABLED=false
# OPENAI_API_KEY=${GEMINI_API_KEY}  # same key; OpenAiLlmClient reads OPENAI_API_KEY
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_CHAT_MODEL=gemini-3.6-flash

# File storage
STORAGE_PATH=./uploads              # local file storage directory

# Frontend
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# Transactional email — Brevo (https://www.brevo.com)
# Enable NOTIFICATION_ENABLED=true to activate email sending.
NOTIFICATION_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
BREVO_API_KEY=                          # Brevo API key from Settings → API Keys
BREVO_SENDER_EMAIL=                     # verified sender address in your Brevo account
BREVO_SENDER_NAME=Resume Intelligence   # display name shown in recipient inbox
BREVO_BASE_URL=https://api.brevo.com    # override only in tests (e.g. http://localhost:<port>)
NOTIFICATION_ADMIN_EMAIL=               # optional: admin inbox for new-user notifications
FRONTEND_BASE_URL=http://localhost:5173 # used in welcome email CTA link

# Legacy Resend variables — kept for reference until Brevo is confirmed in production.
# These are no longer read by application code but are preserved here for rollback reference.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
NOTIFICATION_SENDER_ADDRESS=

# Observability (Grafana admin login; dev default only — change for any shared deployment).
# The backend management port (9091) is fixed in application.yml and NOT published by compose.
GRAFANA_ADMIN_PASSWORD=admin
